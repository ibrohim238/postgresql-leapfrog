-- leapfrog_example: the README example verbatim, so its plans and counters cannot drift.
--
LOAD 'leapfrog';
SET max_parallel_workers_per_gather = 0;
-- EXPLAIN ANALYZE without timings, buffers and sort memory.
CREATE FUNCTION lf_explain_analyze(query text) RETURNS SETOF text
LANGUAGE plpgsql AS $$
DECLARE
	line text;
BEGIN
	FOR line IN EXECUTE
		'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || query
	LOOP
		RETURN NEXT regexp_replace(line, 'Memory: \d+kB', 'Memory: NkB');
	END LOOP;
END
$$;
CREATE TABLE orders (
    id          bigint PRIMARY KEY,
    customer_id bigint NOT NULL,
    deleted_at  timestamptz,
    payload     text
);
INSERT INTO orders
SELECT g, abs(hashint8(g)) % 200,
       CASE WHEN g <= 400000 AND abs(hashint8(g * 7 + 3)) % 5 = 0
            THEN '2026-01-01'::timestamptz END,
       repeat('x', 100)
FROM generate_series(1, 1000000::bigint) g;
CREATE INDEX idx_orders_customer_id ON orders (customer_id, id);
CREATE INDEX idx_orders_active_id   ON orders (id) WHERE deleted_at IS NULL;
CREATE INDEX idx_orders_deleted_id  ON orders (id) WHERE deleted_at IS NOT NULL;
VACUUM ANALYZE orders;
-- With random_page_cost = 1.1 (data in memory or on SSD) the planner picks the node by cost.
SET random_page_cost = 1.1;
SELECT * FROM lf_explain_analyze($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 100 $$);
                                lf_explain_analyze                                
----------------------------------------------------------------------------------
 Limit (actual rows=100.00 loops=1)
   ->  Custom Scan (Index Merge Intersect) on orders (actual rows=100.00 loops=1)
         Matched TIDs: 100
         Heap Fetches: 100
         Peak Group Memory: 96 B
         Skips: 4
         Short Skips: 3
         ->  Outer Stream on idx_orders_customer_id (actual rows=585.00 loops=1)
               Index Cond: (customer_id = 100)
               Skips: 1
               Short Skips: 0
               Prefetches: 4
         ->  Inner Stream on idx_orders_deleted_id (actual rows=20131.00 loops=1)
               Index Pred: (deleted_at IS NOT NULL)
               Skips: 3
               Short Skips: 3
               Prefetches: 58
(17 rows)

RESET random_page_cost;
-- With the default random_page_cost = 4 as well.
SELECT * FROM lf_plan_costs($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 100 $$);
                                  lf_plan_costs                                  
---------------------------------------------------------------------------------
 Limit  (cost=N..N rows=N width=N)
   ->  Custom Scan (Index Merge Intersect) on orders  (cost=N..N rows=N width=N)
         ->  Outer Stream on idx_orders_customer_id
               Index Cond: (customer_id = N)
         ->  Inner Stream on idx_orders_deleted_id
               Index Pred: (deleted_at IS NOT NULL)
(6 rows)

-- Stock plan: the partial index, filtering the customer on every deleted row.
SET leapfrog.enabled = off;
SELECT * FROM lf_explain_analyze($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 100 $$);
                                      lf_explain_analyze                                      
----------------------------------------------------------------------------------------------
 Limit (actual rows=100.00 loops=1)
   ->  Index Scan Backward using idx_orders_deleted_id on orders (actual rows=100.00 loops=1)
         Filter: (customer_id = 100)
         Rows Removed by Filter: 20204
         Index Searches: 1
(5 rows)

RESET leapfrog.enabled;
-- BitmapAnd: both indexes read completely, every match fetched, then sorted.
SET leapfrog.enabled = off;
SET enable_indexscan = off;
SELECT * FROM lf_explain_analyze($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 100 $$);
                                        lf_explain_analyze                                         
---------------------------------------------------------------------------------------------------
 Limit (actual rows=100.00 loops=1)
   ->  Sort (actual rows=100.00 loops=1)
         Sort Key: id DESC
         Sort Method: top-N heapsort  Memory: NkB
         ->  Bitmap Heap Scan on orders (actual rows=393.00 loops=1)
               Recheck Cond: ((customer_id = 100) AND (deleted_at IS NOT NULL))
               Heap Blocks: exact=379
               ->  BitmapAnd (actual rows=0.00 loops=1)
                     ->  Bitmap Index Scan on idx_orders_customer_id (actual rows=5054.00 loops=1)
                           Index Cond: (customer_id = 100)
                           Index Searches: 1
                     ->  Bitmap Index Scan on idx_orders_deleted_id (actual rows=80120.00 loops=1)
                           Index Searches: 1
(13 rows)

RESET enable_indexscan;
-- Index Scan on (customer_id, id), filtering deleted_at on every row of the customer.
BEGIN;
DROP INDEX idx_orders_deleted_id;
SET LOCAL enable_bitmapscan = off;
SELECT * FROM lf_explain_analyze($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 100 $$);
                                      lf_explain_analyze                                       
-----------------------------------------------------------------------------------------------
 Limit (actual rows=100.00 loops=1)
   ->  Index Scan Backward using idx_orders_customer_id on orders (actual rows=100.00 loops=1)
         Index Cond: (customer_id = 100)
         Filter: (deleted_at IS NOT NULL)
         Rows Removed by Filter: 3454
         Index Searches: 1
(6 rows)

ROLLBACK;
RESET leapfrog.enabled;
-- Without LIMIT the planner's pick depends on the ANALYZE sample: only the node's work is checked.
SELECT * FROM lf_counters($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC $$);
      counter       |          value           
--------------------+--------------------------
 Outer Index        | "idx_orders_customer_id"
 Inner Index        | "idx_orders_deleted_id"
 Outer Entries Read | 2085
 Inner Entries Read | 79870
 Matched TIDs       | 393
 Heap Fetches       | 393
 Skips              | 4
 Short Skips        | 3
 Peak Group Memory  | 96
 Actual Rows        | 393.00
 Actual Loops       | 1
(11 rows)

SELECT lf_check($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 100 $$);
                      lf_check                       
-----------------------------------------------------
 custom scan: t, rows: 100/100, missing: 0, extra: 0
(1 row)

SELECT lf_check($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC $$);
                      lf_check                       
-----------------------------------------------------
 custom scan: t, rows: 393/393, missing: 0, extra: 0
(1 row)

DROP TABLE orders;
DROP FUNCTION lf_explain_analyze(text);
