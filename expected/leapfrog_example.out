--
-- leapfrog_example
--
-- The example of the README, verbatim: the same data and queries, so that
-- the plans and counters shown there cannot drift from the code.  Timings
-- and buffer counts differ between machines and are not checked here; the
-- plan shapes and the row and entry counts are deterministic.
--
LOAD 'leapfrog';
SET max_parallel_workers_per_gather = 0;
-- EXPLAIN ANALYZE without timings, buffers and sort memory.
CREATE FUNCTION lf_explain_analyze(query text) RETURNS SETOF text
LANGUAGE plpgsql AS $$
DECLARE
	line text;
BEGIN
	FOR line IN EXECUTE
		'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF) ' || query
	LOOP
		RETURN NEXT regexp_replace(line, 'Memory: \d+kB', 'Memory: NkB');
	END LOOP;
END
$$;
-- 1,000,000 orders of 200 customers (5,000 each).  Recent orders are
-- live; deleted orders are old ones: every fifth among the first 400,000.
CREATE TABLE orders (
    id          bigint PRIMARY KEY,
    customer_id bigint NOT NULL,
    deleted_at  timestamptz,
    payload     text
);
INSERT INTO orders
SELECT g, g % 200,
       CASE WHEN g <= 400000 AND g % 5 = 0 THEN '2026-01-01'::timestamptz END,
       repeat('x', 100)
FROM generate_series(1, 1000000) g;
CREATE INDEX idx_orders_customer_id ON orders (customer_id, id);
CREATE INDEX idx_orders_active_id   ON orders (id) WHERE deleted_at IS NULL;
CREATE INDEX idx_orders_deleted_id  ON orders (id) WHERE deleted_at IS NOT NULL;
VACUUM ANALYZE orders;
-- The latest 100 deleted orders of one customer.
-- The planner picks the node by cost, without leapfrog.force.
SELECT * FROM lf_explain_analyze($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 100 $$);
                                lf_explain_analyze                                
----------------------------------------------------------------------------------
 Limit (actual rows=100.00 loops=1)
   ->  Custom Scan (Index Merge Intersect) on orders (actual rows=100.00 loops=1)
         Outer Index: idx_orders_customer_id
         Inner Index: idx_orders_deleted_id
         Outer Entries Read: 3100
         Inner Entries Read: 3982
         Matched TIDs: 100
         Heap Fetches: 100
         Peak Group Memory: 96 B
(9 rows)

-- Without the extension: an Index Scan on the partial index that filters
-- the customer on every deleted row.
SET leapfrog.enabled = off;
SELECT * FROM lf_explain_analyze($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 100 $$);
                                      lf_explain_analyze                                      
----------------------------------------------------------------------------------------------
 Limit (actual rows=100.00 loops=1)
   ->  Index Scan Backward using idx_orders_deleted_id on orders (actual rows=100.00 loops=1)
         Filter: (customer_id = 100)
         Rows Removed by Filter: 3881
         Index Searches: 1
(5 rows)

-- BitmapAnd: both indexes read completely, every match fetched, then sorted.
SET enable_indexscan = off;
SELECT * FROM lf_explain_analyze($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 100 $$);
                                        lf_explain_analyze                                         
---------------------------------------------------------------------------------------------------
 Limit (actual rows=100.00 loops=1)
   ->  Sort (actual rows=100.00 loops=1)
         Sort Key: id DESC
         Sort Method: top-N heapsort  Memory: NkB
         ->  Bitmap Heap Scan on orders (actual rows=2000.00 loops=1)
               Recheck Cond: ((customer_id = 100) AND (deleted_at IS NOT NULL))
               Heap Blocks: exact=2000
               ->  BitmapAnd (actual rows=0.00 loops=1)
                     ->  Bitmap Index Scan on idx_orders_customer_id (actual rows=5000.00 loops=1)
                           Index Cond: (customer_id = 100)
                           Index Searches: 1
                     ->  Bitmap Index Scan on idx_orders_deleted_id (actual rows=80000.00 loops=1)
                           Index Searches: 1
(13 rows)

RESET enable_indexscan;
-- An Index Scan on (customer_id, id) that filters deleted_at on every row of
-- the customer (the partial index is out of the way in this transaction).
BEGIN;
DROP INDEX idx_orders_deleted_id;
SET LOCAL enable_bitmapscan = off;
SELECT * FROM lf_explain_analyze($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 100 $$);
                                      lf_explain_analyze                                       
-----------------------------------------------------------------------------------------------
 Limit (actual rows=100.00 loops=1)
   ->  Index Scan Backward using idx_orders_customer_id on orders (actual rows=100.00 loops=1)
         Index Cond: (customer_id = 100)
         Filter: (deleted_at IS NOT NULL)
         Rows Removed by Filter: 3000
         Index Searches: 1
(6 rows)

ROLLBACK;
RESET leapfrog.enabled;
-- Without LIMIT the whole result is needed.  The node and BitmapAnd + Sort
-- are estimated within about 10 % of each other, so which one the planner
-- picks depends on the ANALYZE sample and is not checked; the node's work is.
SELECT * FROM lf_counters($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC $$);
      counter       |          value           
--------------------+--------------------------
 Outer Index        | "idx_orders_customer_id"
 Inner Index        | "idx_orders_deleted_id"
 Outer Entries Read | 5000
 Inner Entries Read | 79982
 Matched TIDs       | 2000
 Heap Fetches       | 2000
 Peak Group Memory  | 96
 Actual Rows        | 2000.00
 Actual Loops       | 1
(9 rows)

-- Same rows as the standard plans, with and without LIMIT.
SELECT lf_check($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 100 $$);
                      lf_check                       
-----------------------------------------------------
 custom scan: t, rows: 100/100, missing: 0, extra: 0
(1 row)

SELECT lf_check($$
SELECT * FROM orders WHERE customer_id = 100 AND deleted_at IS NOT NULL
ORDER BY id DESC $$);
                       lf_check                        
-------------------------------------------------------
 custom scan: t, rows: 2000/2000, missing: 0, extra: 0
(1 row)

DROP TABLE orders;
DROP FUNCTION lf_explain_analyze(text);
