-- Early termination: LIMIT 1 reads a handful of entries, not the indexes.
SELECT * FROM lf_counters($$
SELECT * FROM lf_basic WHERE owner_id = 5 AND deleted_at IS NOT NULL
ORDER BY id DESC LIMIT 1 $$);
      counter       |         value         
--------------------+-----------------------
 Outer Index        | "lf_basic_owner_id"
 Inner Index        | "lf_basic_deleted_id"
 Outer Entries Read | 1
 Inner Entries Read | 4
 Matched TIDs       | 1
 Heap Fetches       | 1
 Peak Group Memory  | 96
 Actual Rows        | 1.00
 Actual Loops       | 1
(9 rows)

-- Without LIMIT every entry of both sides is read, and only matches are
-- fetched from the heap.
SELECT * FROM lf_counters($$
SELECT * FROM lf_basic WHERE owner_id = 5 AND deleted_at IS NOT NULL
ORDER BY id $$);
      counter       |         value         
--------------------+-----------------------
 Outer Index        | "lf_basic_owner_id"
 Inner Index        | "lf_basic_deleted_id"
 Outer Entries Read | 1000
 Inner Entries Read | 3570
 Matched TIDs       | 143
 Heap Fetches       | 143
 Peak Group Memory  | 96
 Actual Rows        | 143.00
 Actual Loops       | 1
(9 rows)

